#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    macros {
        repeat: repeat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_2 &kp NUMBER_4 &kp NUMBER_2 &kp NUMBER_4 &kp NUMBER_2 &kp NUMBER_4>;
            label = "REPEAT";
        };

        snip: snip {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHFT &kp LEFT_GUI &kp S>;
            label = "SNIP";
        };

        lock: lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp L>;
            label = "LOCK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // This is a sample keymap intended to be replaced with your own

        Nav {
            bindings = <
&trans    &trans    &repeat    &snip      &lock   &kp K_REDO  &kp LS(INS)    &kp LC(INS)  &kp LS(DELETE)  &kp K_UNDO
&kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans  &caps_word  &kp LEFT       &kp DOWN     &kp UP          &kp RIGHT
&trans    &trans    &trans     &trans     &trans  &kp INS     &kp HOME       &kp PG_DN    &kp PG_UP       &kp END
                    &trans     &trans     &trans  &kp ENTER   &kp BACKSPACE  &kp DEL
            >;
        };

        Base {
            bindings = <
&kp Q       &kp W       &kp E        &kp R             &kp T      &kp Y        &kp U        &kp I         &kp O       &kp P
&mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LEFT_SHIFT F  &kp G      &kp H        &mt LSHFT J  &mt RCTRL K   &mt LALT L  &mt RGUI SQT
&lt 7 Z     &kp X       &kp C        &kp V             &kp B      &kp N        &kp M        &kp COMMA     &kp DOT     &kp SLASH
                        &lt 3 ESC    &lt 0 SPACE       &lt 2 TAB  &lt 5 ENTER  &lt 4 BACKSPACE    &lt 6 DELETE
            >;
        };

        Mouse {
            bindings = <
&kp DOUBLE_QUOTES  &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LC(X)         &kp LC(C)  &kp UP         &kp LC(V)  &trans
&kp LS(NUMBER_1)   &kp LS(NUMBER_2)      &kp LS(NUMBER_3)       &kp LS(NUMBER_4)  &kp LS(N5)         &kp SINGLE_QUOTE  &kp LEFT   &kp DOWN       &kp RIGHT  &trans
&kp LS(NUMBER_6)   &kp LS(N7)            &kp LS(N8)             &kp LS(N9)        &kp LS(N0)         &kp MINUS         &kp EQUAL  &kp BACKSLASH  &kp GRAVE  &trans
                                         &trans                 &trans            &kp LSHFT          &trans            &trans     &trans
            >;
        };

        Media {
            bindings = <
&trans  &trans  &trans  &kp LS(Z)  &trans  &trans  &trans  &trans  &trans  &trans
&kp LGUI         &kp LALT         &kp LCTRL        &kp LSHIFT       &trans   &trans  &kp C_PREV        &kp C_VOL_DN     &kp C_VOL_UP     &kp C_NEXT
&trans           &kp RALT         &trans           &trans           &trans  &out BT_CLR_ALL       &bt BT_SEL 0      &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3
                &trans  &trans     &trans  &kp K_STOP         &kp C_PLAY_PAUSE  &kp C_MUTE
            >;
        };

        Num {
            bindings = <
&kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET   &trans  &trans  &trans  &trans  &trans
&kp SEMI          &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL  &trans  &kp RSHFT  &kp RCTRL  &kp LALT  &kp RGUI
&kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH   &trans  &trans     &trans     &kp RALT  &trans
                &kp DOT       &kp NUMBER_0  &kp MINUS   &trans  &trans  &trans
            >;
        };

        Sym {
            bindings = <
&kp LEFT_BRACE  &kp AMPERSAND  &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE  &trans  &trans  &trans  &trans  &trans
&kp COLON       &kp DOLLAR     &kp PERCENT           &kp CARET              &kp PLUS  &trans  &kp RSHFT  &kp RCTRL  &kp LALT  &kp RGUI  &trans
&kp TILDE       &kp EXCL       &kp AT                &kp HASH               &kp PIPE  &trans  &trans     &trans     &kp RALT  &trans
                &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER   &trans  &trans  &trans
            >;
        };

        Fun {
            bindings = <
&kp F12  &kp F7  &kp F8             &kp F9     &kp PRINTSCREEN  &trans  &trans  &trans  &trans  &trans
&kp F11  &kp F4  &kp F5             &kp F6     &kp SCROLLLOCK  &trans  &kp RSHFT  &kp RCTRL  &kp LALT  &kp RGUI
&kp F10  &kp F1  &kp F2             &kp F3     &kp PAUSE_BREAK  &trans  &kp RSHFT  &kp RCTRL  &kp LALT  &kp RGUI
                &kp K_APPLICATION  &kp SPACE  &kp TAB    &trans  &trans  &trans
            >;
        };

        Buttons {
            bindings = <
&kp K_UNDO  &kp LS(DEL)  &kp LC(INS)  &kp LS(INS)     &kp K_REDO  &kp K_REDO   &kp LS(INS)     &kp LC(INS)  &kp LS(DEL)  &kp K_UNDO 
&kp LGUI    &kp LALT     &kp LCTRL    &kp LSHFT       &trans  &trans       &kp RSHFT       &kp RCTRL    &kp LALT     &kp RGUI
&trans      &kp RALT     &sys_reset   &studio_unlock  &bootloader  &bootloader  &studio_unlock  &sys_reset   &kp RALT     &trans
                &mkp MCLK    &mkp LCLK       &mkp RCLK    &mkp RCLK    &mkp LCLK       &mkp MCLK
            >;
        };
    };
};
